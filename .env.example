# .env.example - Copy this to .env and fill in your actual values

# Database connection (Render will provide this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CoinGecko API Key (get from https://www.coingecko.com/en/api)
COINGECKO_API_KEY=your_api_key_here

# Flask secret key (generate with: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=your_secret_key_here

# Flask environment (use 'production' for deployment)
FLASK_ENV=production
